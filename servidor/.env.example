# MongoDB debe ejecutarse como replica set para las operaciones atomicas entre documentos.
MONGODB_URI=mongodb://127.0.0.1:27017/innovation_hub?replicaSet=rs0
# Puerto HTTP que usa el servidor; coincide con VITE_API_URL del cliente.
PORT=3000
# Origen exacto de Vite autorizado a enviar cookies; no usar un asterisco.
CLIENT_ORIGIN=http://localhost:5173
# Sustituir por un secreto aleatorio de al menos 32 caracteres antes de iniciar.
SESSION_SECRET=
# En produccion se requieren HTTPS y cookies seguras.
NODE_ENV=development
# Clave exclusiva para cuentas ficticias; configurar solo al cargar una base _demo.
SEED_PASSWORD=
