{
  "info": {
    "name": "Innovation Hub - Servidor J1-J10",
    "description": "Ejecutar sobre semillas de una base _demo. Configurar clavePruebas localmente; no exportar claves ni cookies. Complementa la coleccion de participacion sin modificarla.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "clavePruebas",
      "value": ""
    },
    {
      "key": "cookiePropietario",
      "value": ""
    },
    {
      "key": "iniciativaCreadaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticacion: login correcto y captura de sesion",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"propietario@example.test\",\n  \"contrasena\": \"{{clavePruebas}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON', () => pm.response.to.be.json);",
              "if (pm.response.code === 200) pm.collectionVariables.set('cookiePropietario', pm.response.headers.get('Set-Cookie').split(';')[0]);",
              "pm.test('Sin hash', () => pm.expect(pm.response.json()).not.to.have.property('hash'));"
            ]
          }
        }
      ]
    },
